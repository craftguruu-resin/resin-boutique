# Template: copy values from Render → Secret Manager (DO NOT commit filled file).
# Usage: infra/gcp/setup-secrets.sh reads secret values from your environment or prompts.
#
# craftguru-database-url          → DATABASE_URL (Neon pooled URL)
# craftguru-razorpay-key-id       → RAZORPAY_KEY_ID
# craftguru-razorpay-key-secret   → RAZORPAY_KEY_SECRET
# craftguru-whatsapp-access-token → WHATSAPP_ACCESS_TOKEN
# craftguru-whatsapp-phone-number-id → WHATSAPP_PHONE_NUMBER_ID
# craftguru-bill-api-secret       → BILL_API_SECRET (optional)
# craftguru-guest-otp-pepper      → GUEST_OTP_PEPPER (optional)
# craftguru-google-client-id      → GOOGLE_CLIENT_ID
# craftguru-smtp-pass             → SMTP_PASS or GMAIL_APP_PASSWORD
# craftguru-vendor-portal-password → VENDOR_PORTAL_PASSWORD
#
# Cloudinary: no secrets — image URLs stored in Neon.
