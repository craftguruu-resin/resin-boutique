# Copy to .env and fill in. Never commit real secrets.
#
# --- DATABASE_URL: local vs production (same repo, no Git conflict) ---
# • Local:     put DATABASE_URL only in this file (server/.env). This file is gitignored — never pushed.
# • Production (Cloud Run): Secret Manager → craftguru-database-url (Neon pooled URL).
# • Legacy Render: Render → Environment (until cutover). See docs/RENDER-TO-GCP-ZERO-DOWNTIME.md
#

# Cloud Run injects PORT=8080. Local: use 8080 or 3847 (match data-bill-api-port on HTML if needed).
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# --- Neon PostgreSQL (KEEP — do not migrate to Cloud SQL) ---
# Prefer Neon *pooled* connection string with sslmode=require.
# DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require
# PG_POOL_MAX=5
# PG_IDLE_TIMEOUT_MS=30000
# PG_CONNECT_TIMEOUT_MS=10000
# PG_SSL=true
# PG_SSL_REJECT_UNAUTHORIZED=true
# PG_KEEPALIVE_DELAY_MS=10000

# --- Cloudinary ---
# No server SDK required. Store https://res.cloudinary.com/... URLs in product image fields.
# Keep Cloudinary account/config unchanged.

# --- Persistent uploads (optional; Cloud Run disk is ephemeral) ---
# Prefer Cloudinary HTTPS URLs. If you must write files, they vanish on new revisions unless
# you use an external volume (not available on Cloud Run). See server/PERSISTENT-MEDIA-SETUP.md
# UPLOADED_MEDIA_ROOT=/var/data/craftguru-media
# CATALOG_MEDIA_ROOT=
# HERO_MEDIA_ROOT=
# RAW_MATERIALS_MEDIA_ROOT=
# PHOTO_FRAME_PRODUCTS_MEDIA_ROOT=

# JPEG preview (no token): POST /api/preview-bill-jpeg with body { "items": [...], "phone": "optional 10 digits" }

# Permanent access token (or system user token) with whatsapp_business_messaging
WHATSAPP_ACCESS_TOKEN=

# From WhatsApp → API Setup → "Phone number ID" (not your display number)
WHATSAPP_PHONE_NUMBER_ID=

# Optional. Default v21.0
# META_GRAPH_VERSION=v21.0

# CORS: production = comma-separated origins. Local dev: prefer * so Live Server / any port can call the API.
# A short list (e.g. only :5500) blocks the vendor login fetch if your editor uses :5501 or you open the site from another origin.
ALLOWED_ORIGIN=*

# Optional shared secret. If set, checkout AND vendor pages must send it: same value as data-bill-api-secret on
# checkout.html and vendor-*.html <html> (see comments in those files). Server middleware requires it for /api/vendor/* except /status and /categories.
# For vendor-only locking (VENDOR_PORTAL_*): leave BILL_API_SECRET unset — then data-bill-api-secret can stay empty.
# BILL_API_SECRET=

# Optional: extra entropy for guest email OTP hashes (defaults to a built-in string if unset).
# GUEST_OTP_PEPPER=

# --- Google Sign-In (optional, free for typical retail traffic) ---
# Same OAuth 2.0 Web client ID as on storefront HTML: data-google-client-id="....apps.googleusercontent.com"
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID → Web application.
# Authorized JavaScript origins: https://your-domain.com  and http://127.0.0.1:PORT for local testing.
# GOOGLE_CLIENT_ID=

# --- Google Places Autocomplete (checkout address fields) ---
# Enable Maps JavaScript API + Places API in Google Cloud Console.
# Restrict the key to your domain(s). Used client-side for address autofill only.
# GOOGLE_MAPS_API_KEY=

# --- Email OTP (6-digit sign-in / sign-up codes via nodemailer) ---
# If neither block below is set, OTPs are printed in the API server console instead of emailed.
#
# Option A — any SMTP provider (Hostinger, Zoho, SendGrid SMTP, Amazon SES SMTP, etc.):
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=orders@yourdomain.com
# SMTP_PASS=your-smtp-password
# MAIL_FROM="Craftguru <orders@yourdomain.com>"
#
# Option B — Gmail (use an App Password, not your normal password; Google Account → Security → App passwords):
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=xxxx
# MAIL_FROM="Craftguru <you@gmail.com>"

# Vendor /api/*: on Cloud Run (K_SERVICE) and Render (RENDER=true), auth is ON by default unless VENDOR_REQUIRE_AUTH=0.
# Force on anywhere: VENDOR_REQUIRE_AUTH=1. Force off: VENDOR_REQUIRE_AUTH=0
# VENDOR_REQUIRE_AUTH=1

# Sliding idle: no authenticated vendor API call for this long → sign in again (default 1 hour). Tune for tests e.g. 120000
# VENDOR_SESSION_IDLE_MS=3600000

# Vendor dashboard login. With Postgres, `npm run db:migrate` syncs this user (insert or update password).
# If nammu/nammu fails, run: npm run db:vendor-login   (from server/ with DATABASE_URL set)
# Without DATABASE_URL: credentials come from env only (Cloud Run Secret Manager / Render Environment).
# Defaults if unset: username nammu, password nammu
# VENDOR_PORTAL_USER=studio
# VENDOR_PORTAL_PASSWORD=change-me

# --- Razorpay (required for checkout — live money on production) ---
# 1) https://dashboard.razorpay.com/ → complete KYC → switch dashboard to **Live** (top toggle).
# 2) Account & Settings → API Keys → Generate Key (Live).
# 3) Paste BOTH values below (local dev: copy this file to `.env` in server/ and uncomment).
#    Production: Render / Cloud Run Environment OR GCP Secret Manager (see HOSTING.md).
#
# You need exactly TWO secrets (no webhook secret required for current checkout flow):
#   RAZORPAY_KEY_ID     → starts with rzp_live_…  (public — also sent to browser checkout widget)
#   RAZORPAY_KEY_SECRET → long secret string       (server only — never put in HTML or git)
#
# Test keys (rzp_test_…) work on localhost only; production (NODE_ENV=production) blocks test keys.
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxx

# --- PostgreSQL (orders, guests, vendor sessions, catalog in DB) ---
# Prefer setting DATABASE_URL near the top of this file (Neon). If unset, file-based orders (server/data/orders.json).
#
# === Local testing (pick one) ===
#
# (1) Docker — easiest on a Mac/PC with Docker Desktop:
#     cd server && docker compose -f docker-compose.local.yml up -d
#     Wait until healthy, then uncomment ONE line below for local DB:
# DATABASE_URL=postgresql://craftguru:craftguru_local_dev@127.0.0.1:5432/craftguru
#     Then: npm run db:migrate   (and optionally npm run db:vendor-login)
#
# (2) Postgres.app or Homebrew Postgres — create DB + user yourself, then e.g.:
# DATABASE_URL=postgresql://craftguru:yourpassword@127.0.0.1:5432/craftguru
#
# (3) Hosted (Neon) — paste the pooled connection string (production-style URL).
#
# Hostinger shared hosting does NOT include PostgreSQL; use Neon or a VPS with Postgres.

# --- Delhivery shipment tracking (vendor AWB save + guest live tracking + background sync) ---
# Get your API token from Delhivery One → Developer Portal (same token for tracking, labels, etc.).
# Tokens differ between test/staging and production — use the token that matches your API base URL.
#
# Required for live AWB validation, courier sync, and guest ?live=1 tracking:
# DELHIVERY_API_TOKEN=your_api_token_here
#
# Alias (legacy): DELHIVERY_TOKEN=
#
# Environment (pick one):
# • Production (default): track.delhivery.com — leave DELHIVERY_STAGING unset or 0
# • Staging / test only: DELHIVERY_STAGING=1 → staging-express.delhivery.com
#   (blocked when NODE_ENV=production — use production token + track.delhivery.com in prod)
#
# Optional override of API host (advanced; usually leave unset):
# DELHIVERY_API_BASE=https://track.delhivery.com
#
# Static asset preload hints (first-load performance; optional):
# STATIC_PRELOAD_CSS=styles.css,guest-layout.css
# STATIC_PRELOAD_JS=craftguru-api-base.js,data.js
#
# --- BigShip shipping (default provider for new shipments) ---
# Credentials from Bigship panel → API settings.
# BIGSHIP_API_BASE=https://api.bigship.in
# BIGSHIP_USERNAME=your-email@example.com
# BIGSHIP_PASSWORD=your-password
# BIGSHIP_ACCESS_KEY=your-access-key
# BIGSHIP_TOKEN_TTL_MS=3300000
#
# Background sync (Postgres + configured shipping API):
# SHIPMENT_SYNC_INTERVAL_MINUTES=30      # timer interval (min 10)
# SHIPMENT_SYNC_MIN_INTERVAL_MINUTES=15  # per-AWB cooldown between syncs
# SHIPMENT_SYNC_BATCH_SIZE=40            # max orders per batch
# SHIPMENT_SYNC_DISABLED=0               # set 1 to disable in-process timer (cron script still works)
#
# Caching + notifications:
# CATALOG_API_CACHE_MS=60000             # in-memory TTL for GET /api/catalog/* (default 60s)
# SHIPMENT_TRACK_CACHE_MS=300000         # guest/vendor fetch cache (default 5 min)
# SHIPMENT_STALE_MS=21600000             # mark cached view stale after 6 h without sync
# SHIPMENT_NOTIFY_EMAIL=0
# SHIPMENT_NOTIFY_WHATSAPP=0
