{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "server/**",
      "infra/**",
      "docs/**",
      "tools/**",
      "scripts/**",
      "render.yaml",
      "cloudbuild*.yaml",
      "Dockerfile",
      ".dockerignore",
      "package.json",
      "package-lock.json"
    ],
    "headers": [
      {
        "source": "media/catalog/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }
        ]
      },
      {
        "source": "media/hero/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }
        ]
      },
      {
        "source": "media/raw-materials/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }
        ]
      },
      {
        "source": "media/photo-frame-products/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }
        ]
      },
      {
        "source": "media/home-showcase/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
        ]
      },
      {
        "source": "media/photo-frames-showcase/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
        ]
      },
      {
        "source": "media/raw-material-showcase/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
        ]
      },
      {
        "source": "media/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
        ]
      },
      {
        "source": "favicon.ico",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
        ]
      }
    ]
  }
}
